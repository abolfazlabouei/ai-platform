ENV=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/chat_agent_db
REDIS_URL=redis://redis:6379/1
USE_POSTGRES_CHECKPOINTER=true

FILE_SERVICE_URL=http://file-processing-service:8000
KNOWLEDGE_SERVICE_URL=http://knowledge-service:8000

S3_ENDPOINT=http://minio:9000
S3_BUCKET_GENERATED=generated-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MEDIA_PUBLIC_BASE_URL=http://localhost:8101/api/v1/media/files
MAX_MEDIA_UPLOAD_MB=20

JWT_SECRET=dev-shared-jwt-secret-change-in-production
JWT_ALGORITHM=HS256

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_MODEL_PROVIDER=openrouter
DEFAULT_MODEL_NAME=qwen/qwen3.8-omni-flash

IMAGE_GEN_ENABLED=true
IMAGE_GEN_MODEL=google/gemini-nano-banana-2.1
IMAGE_GEN_TIMEOUT_SECONDS=120

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- TEMPORARY: auth disabled for local/demo (set false to require JWT again) ---
AUTH_DISABLED=true
AUTH_DISABLED_USER_ID=local-user

# --- RAG ---
RAG_TOP_K=8
# chars of retrieved text put in the prompt; gemma-2-27b-it has an 8k-token window -> use ~5000 with it
RAG_MAX_CONTEXT_CHARS=12000
RAG_QUERY_REWRITE=true
RAG_DEBUG=true

# --- code-sandbox-service (MCP server registered with auth_config {"type": "sandbox"}) ---
# Must match code-sandbox-service/.env. Generate each with: openssl rand -hex 32
SANDBOX_SHARED_SECRET=
SANDBOX_CONTEXT_SECRET=

# --- Agent skills ---
SKILLS_BUCKET=skills
SKILLS_MAX_PER_AGENT=20
# Phase 2: run skill scripts in code-sandbox-service (needs the SANDBOX_* secrets above)
SKILLS_SCRIPTS_ENABLED=false
SANDBOX_BASE_URL=http://code-sandbox-service:8000
# Browser-reachable MinIO URL, used only to sign links to binary skill files
S3_PUBLIC_BASE_URL=http://localhost:9010
