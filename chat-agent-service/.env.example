ENV=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/chat_agent_db
REDIS_URL=redis://redis:6379/1
USE_POSTGRES_CHECKPOINTER=true

FILE_SERVICE_URL=http://file-processing-service:8000
KNOWLEDGE_SERVICE_URL=http://knowledge-service:8000

S3_ENDPOINT=http://minio:9000
S3_BUCKET_GENERATED=generated-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/generated-media

JWT_SECRET=dev-shared-jwt-secret-change-in-production
JWT_ALGORITHM=HS256

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_MODEL_PROVIDER=anthropic
DEFAULT_MODEL_NAME=claude-sonnet-4-6

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com