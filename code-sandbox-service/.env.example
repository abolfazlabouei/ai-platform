ENV=dev
DEBUG=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/sandbox_db
REDIS_URL=redis://redis:6379/5
DOCKER_HOST=unix:///var/run/docker.sock

# --- Isolation runtime: gVisor. Registered in Docker as "runsc" (see sandbox_feasibility.sh).
# A KVM host can switch to kata / runsc-kvm here. "runc" = NO kernel isolation (local dev only).
SANDBOX_RUNTIME=runsc
SANDBOX_IMAGE_PYTHON=ai-platform-sandbox-python:1

# --- Per-sandbox limits. NOTE: tmpfs (/workspace, /tmp) is RAM —
# SANDBOX_WORKSPACE_SIZE x SANDBOX_MAX_SESSIONS must fit in host memory.
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
SANDBOX_WORKSPACE_SIZE=512m
SANDBOX_MAX_EXEC_SECONDS=120
SANDBOX_DEFAULT_EXEC_SECONDS=30
SANDBOX_MAX_OUTPUT_BYTES=65536

# --- Sessions
SANDBOX_IDLE_TTL_SECONDS=1200
SANDBOX_MAX_LIFETIME_SECONDS=14400
SANDBOX_WARM_POOL_SIZE=2
SANDBOX_MAX_SESSIONS=20
SANDBOX_MAX_SESSIONS_PER_USER=3

# --- Abuse limits
SANDBOX_RATE_LIMIT_PER_MINUTE=30
SANDBOX_DAILY_CPU_SECONDS_PER_USER=3600

# --- Files
SANDBOX_MAX_IMPORT_MB=100

# --- Service-to-service auth. Generate each with: openssl rand -hex 32
# Must match chat-agent-service/.env.
SANDBOX_SHARED_SECRET=
SANDBOX_CONTEXT_SECRET=

FILE_SERVICE_URL=http://file-processing-service:8000

S3_ENDPOINT=http://minio:9000
S3_BUCKET_ARTIFACTS=sandbox-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9010
SANDBOX_ARTIFACT_URL_TTL=86400
