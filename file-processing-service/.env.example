ENV=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/file_processing_db
REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2

S3_ENDPOINT=http://minio:9000
S3_BUCKET_RAW=raw-files
S3_BUCKET_IMAGES=extracted-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000

JWT_SECRET=dev-shared-jwt-secret-change-in-production
JWT_ALGORITHM=HS256

TEXT_CHUNK_SIZE=1000
TEXT_CHUNK_OVERLAP=150
MAX_TABLE_ROWS_PER_CHUNK=30
MAX_UPLOAD_SIZE_MB=100
