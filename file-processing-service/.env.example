ENV=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/file_processing_db
REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2

S3_ENDPOINT=http://minio:9000
S3_BUCKET_RAW=raw-files
S3_BUCKET_IMAGES=extracted-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000

JWT_SECRET=dev-shared-jwt-secret-change-in-production
JWT_ALGORITHM=HS256

TEXT_CHUNK_SIZE=1000
TEXT_CHUNK_OVERLAP=150
MAX_TABLE_ROWS_PER_CHUNK=30
MAX_UPLOAD_SIZE_MB=200
MAX_TABLE_CHUNK_CHARS=3500

# --- TEMPORARY: auth disabled for local/demo (set false to require JWT again) ---
AUTH_DISABLED=true
AUTH_DISABLED_USER_ID=local-user

# --- Vision model: image captioning + OCR of scanned/garbled PDF pages ---
# Without VISION_API_KEY images are skipped (not indexed) and PDFs use their text layer only.
# The model MUST accept image input (gemma-2-27b-it does NOT).
VISION_API_KEY=
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=google/gemini-2.0-flash-001
VISION_OUTPUT_LANGUAGE=Persian
VISION_CONCURRENCY=4
IMAGE_MIN_SIDE_PX=80
# never | auto (scanned or garbled-Persian pages only) | always (every page; most robust for Persian PDFs)
PDF_OCR_MODE=auto
PDF_OCR_DPI=150
