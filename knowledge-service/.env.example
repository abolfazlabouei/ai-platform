ENV=dev
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/knowledge_db
REDIS_URL=redis://redis:6379/3
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/3

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_PREFIX=kb_

FILE_SERVICE_URL=http://file-processing-service:8000

JWT_SECRET=dev-shared-jwt-secret-change-in-production
JWT_ALGORITHM=HS256

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=64

DEFAULT_SEARCH_TOP_K=6

# --- TEMPORARY: auth disabled for local/demo (set false to require JWT again) ---
AUTH_DISABLED=true
AUTH_DISABLED_USER_ID=local-user

EMBEDDING_MAX_RETRIES=3
EMBEDDING_MAX_INPUT_CHARS=6000
